# Copy to .env and fill in real values. Never commit .env.
# Any OpenAI-compatible provider. Default: Google Gemini (free key at https://aistudio.google.com/apikey)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Free tier: each model has its own small daily quota (about 20 requests/day, 10/minute).
# When the main model's daily quota runs out, the fallbacks are tried in order.
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# 768 keeps storage small; gemini-embedding-001 also supports 1536 and 3072
EMBEDDING_DIMENSIONS=768
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600
# Turns off Gemini 2.5 hidden "thinking" tokens. Leave empty for OpenAI gpt-4o-mini.
LLM_REASONING_EFFORT=none
# OpenAI instead: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini  EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=data/chroma
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=5
REFUSAL_THRESHOLD=0.72
