# Copy to .env and fill in real values. Never commit .env.
# Any OpenAI-compatible provider. Default: Google Gemini (free key at https://aistudio.google.com/apikey)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# OpenAI instead: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini  EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=data/chroma
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=5
REFUSAL_THRESHOLD=0.45
